{
    "swagger": "2.0",
    "info": {
        "description": "멀티 DB와 암호화된 설정을 지원하는 REST API 샘플입니다.",
        "title": "My API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/mail/send": {
            "post": {
                "description": "SMTP 서버를 통해 메일을 발송한다",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "mail"
                ],
                "summary": "메일 발송",
                "parameters": [
                    {
                        "description": "메일 발송 요청",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.SendMailRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/dto.SendMailResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/users": {
            "get": {
                "description": "페이징 기반으로 사용자 목록을 조회한다",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "사용자 목록 조회",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "조회 건수",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "오프셋",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.UserListEnvelopeResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "신규 사용자를 생성한다",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "사용자 생성",
                "parameters": [
                    {
                        "description": "사용자 생성 요청",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.UserCreateResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/users/{id}": {
            "get": {
                "description": "ID로 사용자를 조회한다",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "사용자 단건 조회",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "사용자 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.UserGetResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "프로세스가 살아있는지 확인한다",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Liveness 확인",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.HealthResponse"
                        }
                    }
                }
            }
        },
        "/ready": {
            "get": {
                "description": "DB 연결 가능 여부를 확인한다",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Readiness 확인",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.CreateUserRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "alice@example.com"
                },
                "name": {
                    "type": "string",
                    "example": "Alice"
                }
            }
        },
        "dto.ErrorDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "VALIDATION_ERROR"
                },
                "message": {
                    "type": "string",
                    "example": "잘못된 요청입니다"
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/dto.ErrorDetail"
                },
                "request_id": {
                    "type": "string",
                    "example": "7f5f1f8e-6fd7-4d33-bfdf-6d414dc2b0b1"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "dto.HealthData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "dto.HealthResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.HealthData"
                },
                "request_id": {
                    "type": "string",
                    "example": "7f5f1f8e-6fd7-4d33-bfdf-6d414dc2b0b1"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.SendMailAttachmentRequest": {
            "type": "object",
            "properties": {
                "content_base64": {
                    "type": "string",
                    "example": "SGVsbG8gd29ybGQ="
                },
                "content_type": {
                    "type": "string",
                    "example": "text/plain"
                },
                "filename": {
                    "type": "string",
                    "example": "guide.txt"
                }
            }
        },
        "dto.SendMailRequest": {
            "type": "object",
            "properties": {
                "attachments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.SendMailAttachmentRequest"
                    }
                },
                "bcc": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "audit@example.com"
                    ]
                },
                "body": {
                    "type": "string",
                    "example": "Hello, this is a test mail."
                },
                "cc": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "team@example.com"
                    ]
                },
                "is_html": {
                    "type": "boolean",
                    "example": false
                },
                "subject": {
                    "type": "string",
                    "example": "Welcome"
                },
                "to": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "user@example.com"
                    ]
                }
            }
        },
        "dto.SendMailResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.SendMailResponseData"
                },
                "request_id": {
                    "type": "string",
                    "example": "7f5f1f8e-6fd7-4d33-bfdf-6d414dc2b0b1"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.SendMailResponseData": {
            "type": "object",
            "properties": {
                "accepted_recipients": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "dto.UserCreateResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.UserResponse"
                },
                "request_id": {
                    "type": "string",
                    "example": "7f5f1f8e-6fd7-4d33-bfdf-6d414dc2b0b1"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.UserGetResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.UserResponse"
                },
                "request_id": {
                    "type": "string",
                    "example": "7f5f1f8e-6fd7-4d33-bfdf-6d414dc2b0b1"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.UserListEnvelopeResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.UserListResponse"
                },
                "request_id": {
                    "type": "string",
                    "example": "7f5f1f8e-6fd7-4d33-bfdf-6d414dc2b0b1"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "dto.UserListResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "example": 1
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.UserResponse"
                    }
                }
            }
        },
        "dto.UserResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-04-06T10:00:00Z"
                },
                "email": {
                    "type": "string",
                    "example": "alice@example.com"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "Alice"
                },
                "updated_at": {
                    "type": "string",
                    "example": "2026-04-06T10:00:00Z"
                }
            }
        }
    }
}